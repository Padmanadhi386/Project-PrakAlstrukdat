# Salin file ini jadi secrets.toml (di folder yang sama), lalu isi API key kalian.
# File secrets.toml jangan di-push ke GitHub.

# API key NewsAPI, daftar gratis di https://newsapi.org/register
NEWSAPI_KEY = "isi-api-key-newsapi-di-sini"

# API key Gemini, buat di https://aistudio.google.com
GEMINI_API_KEY = "isi-api-key-gemini-di-sini"

# Nama model Gemini. Kalau muncul error 404 (model tidak ditemukan), ganti dengan model yang masih ada.
GEMINI_MODEL = "gemini-flash-latest"